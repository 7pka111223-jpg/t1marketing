# Local preview can run without Supabase when this is true.
NEXT_PUBLIC_DEMO_MODE=true

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-to-server conversion attribution (see README section 7).
# Generate with: openssl rand -hex 32
MARKETING_INGEST_SECRET=

# Trigger.dev
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# Low-cost open-weight model gateway. Keep provider/model swappable.
OPENROUTER_API_KEY=
AI_MODEL=
AI_BASE_URL=https://openrouter.ai/api/v1

# AI video generation (OpenRouter /videos, MiniMax H3 family). Hard monthly cap enforced in the API
# before anything is submitted. A 5s 2K H3 clip costs $0.65, so the default buys ~15 clips a month.
VIDEO_MONTHLY_CAP_USD=10

# Fan cam (fal). Chains an OpenRouter planner to two fal models: an image edit that composites a
# cleared portrait into a crowd scene, then an image-to-video pass. It draws on the SAME
# VIDEO_MONTHLY_CAP_USD budget above — one pot, so fal cannot quietly spend a second $10.
# A 5s silent fan cam is about $0.47.
FAL_KEY=
# Optional overrides. fal renames endpoints between model generations; verify on the model's
# playground before changing these.
FAL_IMAGE_MODEL=fal-ai/nano-banana/edit
FAL_VIDEO_MODEL=fal-ai/kling-video/v3/standard/image-to-video

# Social publishing - intentionally disabled until app/API approvals are complete.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=

# Public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
