# Local preview can run without Supabase when this is true.
NEXT_PUBLIC_DEMO_MODE=true

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-to-server conversion attribution (see README section 7).
# Generate with: openssl rand -hex 32
MARKETING_INGEST_SECRET=

# Trigger.dev
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# Low-cost open-weight model gateway. Keep provider/model swappable.
OPENROUTER_API_KEY=
AI_MODEL=
AI_BASE_URL=https://openrouter.ai/api/v1

# Social publishing - intentionally disabled until app/API approvals are complete.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=

# Public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
